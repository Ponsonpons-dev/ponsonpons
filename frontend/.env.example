# Indexer base URL (Phase 2 app).
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069

# Contract addresses from contracts/deployments/4663.json.
NEXT_PUBLIC_LAUNCH_FACTORY=
NEXT_PUBLIC_QUOTE_REGISTRY=
NEXT_PUBLIC_FEE_ESCROW=
NEXT_PUBLIC_HOOK=
NEXT_PUBLIC_LOCKER=
# "timelock" if the stack was deployed with USE_TIMELOCK=true, else "direct".
# This drives what /proof and the trust docs claim, so it must match reality.
NEXT_PUBLIC_GOVERNANCE=direct
# Only set when NEXT_PUBLIC_GOVERNANCE=timelock.
NEXT_PUBLIC_TIMELOCK=
NEXT_PUBLIC_PROTOCOL_OWNER=

# Robinhood Chain.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# WalletConnect cloud project id (RainbowKit).
NEXT_PUBLIC_WALLETCONNECT_ID=
