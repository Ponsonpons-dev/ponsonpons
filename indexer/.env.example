# Archive-grade RPC strongly recommended for backfill (the public endpoint
# rate-limits and Cloudflare-challenges heavy clients).
PONDER_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com
PONDER_RPS=10

# Postgres (ponder dev falls back to embedded PGlite when unset).
DATABASE_URL=postgres://ponder:ponder@localhost:5432/pop

# From contracts/deployments/4663.json after `forge script script/Deploy.s.sol`.
POP_LAUNCH_FACTORY=
POP_HOOK=
POP_QUOTE_REGISTRY=
POP_FEE_ESCROW=
UNISWAP_V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
# Pure periphery, present in deployments for the frontend; not indexed.
POP_SWAP_ROUTER=
# Deployment block of the factory, do not backfill from genesis.
POP_START_BLOCK=
